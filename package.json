{
  "name": "flightmon",
  "private": true,
  "version": "0.1.0",
  "description": "A flight radar for a spare screen: a second monitor or an old iPad.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js && npm run check:es5",
    "check:es5": "acorn --ecma5 --silent public/app.js"
  },
  "devDependencies": {
    "acorn": "^8.15.0"
  }
}
